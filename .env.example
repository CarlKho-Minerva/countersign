# Copy to .env (never commit it). Read by the app when it starts.

# The model. Production: Vultr Serverless Inference (OpenAI-compatible).
# CS_MODEL_PROVIDER is one of: vultr, azure, openai, local, none
CS_MODEL_PROVIDER=vultr
VULTR_INFERENCE_API_KEY=
# Must accept images; the live list is at https://api.vultrinference.com/v1/models
CS_MODEL=qwen3.8-27b
# CS_VISION_MODEL defaults to CS_MODEL.
# Prices in USD per 1M tokens, for the spend meter:
# CS_PRICE_IN=1.0
# CS_PRICE_OUT=1.0
# Model calls stop, loudly, once this many dollars are spent:
CS_SPEND_CAP_USD=20

# Development alternatives:
#   CS_MODEL_PROVIDER=azure with AZURE_OPENAI_BASE_URL=https://<resource>.cognitiveservices.azure.com/openai/v1,
#     AZURE_OPENAI_API_KEY and CS_MODEL=<deployment name>
#   CS_MODEL_PROVIDER=local with CS_MODEL_BASE_URL=http://<vllm-host>:8000/v1 and CS_MODEL=<served model name>

# The app.
# 1: learns only the bundled test forms, and anyone can try the flow. 0: needs CS_OWNER_PASSWORD.
CS_DEMO=1
# CS_OWNER_PASSWORD=
# Sandboxes running at once (each gets 1 CPU, 1 GB and 60 s).
CS_MAX_SANDBOXES=2
# A host name gets automatic HTTPS (e.g. 203.0.113.5.sslip.io); :80 serves plain HTTP.
CS_SITE=:80
